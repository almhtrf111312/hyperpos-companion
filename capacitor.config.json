{
  "appId": "com.flowpos.pro",
  "appName": "FlowPOS Pro",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "Camera": {
      "photoGalleryPermission": "لاختيار صور المنتجات",
      "cameraPermission": "لمسح الباركود وتصوير المنتجات",
      "saveToGallery": false
    },
    "Filesystem": {
      "androidExternalStorage": true
    }
  }
}
